# Backend
APP_ENV=development
APP_NAME=BusinessBrain API
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://businessbrain:businessbrain@localhost:5432/businessbrain
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Private Deal Room document storage (S3-compatible, private bucket)
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_UPLOAD_URL_EXPIRE_SECONDS=300
S3_DOWNLOAD_URL_EXPIRE_SECONDS=60
# Incomplete quarantine uploads older than this are removed by the scheduled cleanup job.
QUARANTINE_UPLOAD_TTL_HOURS=24
# ClamAV daemon is required; uploads stay quarantined until a clean scan completes.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=60
